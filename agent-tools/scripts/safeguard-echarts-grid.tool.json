{
  "name": "safeguard-echarts-grid",
  "type": "script",
  "category": "post-processing",
  "description": "守护 ECharts grid 配置，确保图表渲染区域不被坐标轴标签遮挡",
  "invocation": "node agent-tools/scripts/safeguard-echarts-grid.mjs <input.html> [output.html] [--in-place]",
  "parameters": {
    "input_path": { "type": "string", "required": true, "description": "输入 HTML 路径" },
    "output_path": { "type": "string", "required": false, "description": "输出路径" },
    "in_place": { "type": "boolean", "required": false, "description": "原地修改" }
  },
  "returns": { "type": "string", "description": "grid 守护处理后的 HTML" },
  "exitCodes": { "0": "grid 守护完成", "1": "处理失败" },
  "mandatory": false,
  "stageUsage": ["stage-7b"]
}
