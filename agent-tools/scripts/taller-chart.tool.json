{
  "name": "taller-chart",
  "type": "script",
  "category": "post-processing",
  "description": "增加图表容器高度，为数据标签预留更多展示空间",
  "invocation": "node agent-tools/scripts/taller-chart.mjs <input.html> [output.html]",
  "parameters": {
    "input_path": { "type": "string", "required": true, "description": "输入 HTML 路径" },
    "output_path": { "type": "string", "required": false, "description": "输出路径" }
  },
  "returns": { "type": "string", "description": "高度增加后的 HTML" },
  "exitCodes": { "0": "高度调整完成", "1": "处理失败" },
  "mandatory": false,
  "stageUsage": ["stage-7b"]
}
