{
  "name": "audit-state-structure",
  "type": "script",
  "category": "validation",
  "description": "审计 analysis-state.md 的章节结构完整性，确保所有必需章节存在且有内容",
  "invocation": "node agent-tools/scripts/audit-state-structure.mjs <analysis-state.md路径> [--json] [--stage=N]",
  "parameters": {
    "state_path": { "type": "string", "required": true, "description": "analysis-state.md 文件路径" },
    "json": { "type": "boolean", "required": false, "description": "以 JSON 格式输出结果" },
    "stage": { "type": "number", "required": false, "description": "指定当前工作阶段编号 N" }
  },
  "returns": { "type": "object", "description": "章节结构校验结果" },
  "exitCodes": { "0": "所有必需章节存在且内容完整", "1": "缺少章节或内容为空 → HALT" },
  "mandatory": true,
  "stageUsage": ["stage-1", "all"]
}
