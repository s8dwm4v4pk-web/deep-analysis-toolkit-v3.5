{
  "name": "fix-overflow",
  "type": "script",
  "category": "post-processing",
  "description": "修复 HTML 报告中内容溢出容器的布局问题",
  "invocation": "node agent-tools/scripts/fix-overflow.mjs <input.html> [output.html]",
  "parameters": {
    "input_path": { "type": "string", "required": true, "description": "输入 HTML 路径" },
    "output_path": { "type": "string", "required": false, "description": "输出路径" }
  },
  "returns": { "type": "string", "description": "溢出修复后的 HTML" },
  "exitCodes": { "0": "溢出修复完成", "1": "处理失败" },
  "mandatory": false,
  "stageUsage": ["stage-7b"]
}
