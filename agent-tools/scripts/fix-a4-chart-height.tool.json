{
  "name": "fix-a4-chart-height",
  "type": "script",
  "category": "post-processing",
  "description": "修复 A4 打印场景下图表高度超出纸张范围的问题",
  "invocation": "node agent-tools/scripts/fix-a4-chart-height.mjs <input.html> [output.html] [--aggressive]",
  "parameters": {
    "input_path": { "type": "string", "required": true, "description": "输入 HTML 路径" },
    "output_path": { "type": "string", "required": false, "description": "输出路径" },
    "aggressive": { "type": "boolean", "required": false, "description": "激进模式，更大力度压缩" }
  },
  "returns": { "type": "string", "description": "高度修复后的 HTML" },
  "exitCodes": { "0": "高度修复完成", "1": "处理失败" },
  "mandatory": false,
  "stageUsage": ["stage-7b"]
}
