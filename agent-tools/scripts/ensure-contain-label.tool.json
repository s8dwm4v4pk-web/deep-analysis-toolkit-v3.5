{
  "name": "ensure-contain-label",
  "type": "script",
  "category": "post-processing",
  "description": "确保 ECharts 图表中所有数据标签 (label) 都显示在容器内不溢出",
  "invocation": "node agent-tools/scripts/ensure-contain-label.mjs <input.html> [output.html] [--in-place]",
  "parameters": {
    "input_path": { "type": "string", "required": true, "description": "输入 HTML 路径" },
    "output_path": { "type": "string", "required": false, "description": "输出路径" },
    "in_place": { "type": "boolean", "required": false, "description": "原地修改，不生成新文件" }
  },
  "returns": { "type": "string", "description": "标签处理后的 HTML" },
  "exitCodes": { "0": "标签调整完成", "1": "处理失败" },
  "mandatory": false,
  "stageUsage": ["stage-7b"]
}
